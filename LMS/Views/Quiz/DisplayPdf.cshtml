@model StudentQuiz
@{
    ViewData["Title"] = "DisplayPdf";
}

<h1>DisplayPdf</h1>

@if (!string.IsNullOrEmpty(Model.StudentAnswerPath))
{
	<div class="pdf-container container" style="width: 100%; height: 100vh;">
		<embed src="~/@Model.StudentAnswerPath" type="application/pdf" width="100%" height="100%">
	</div>
}
else
{
	<p>لا يوجد ملف إجابة مُسلَّم لهذه المحاولة.</p>
}
