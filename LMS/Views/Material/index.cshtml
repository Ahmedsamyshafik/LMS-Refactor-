@model LMS.ViewModels.Material.MaterialVM
@{
    ViewData["Title"] = "AddPdf";
}


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pdf.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@200;300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/all.min.css">
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/bootstrap.min.css.map">
</head>
<body>
    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
    {
        <form class="addQuiz " method="post" asp-action="Add" asp-controller="Material" enctype="multipart/form-data">

            <div asp-validation-summary="All" class="text-danger"></div>

            <label for="file">الملف (PDF فقط):</label>
            <input type="file" id="file" class="form-control" asp-for="@Model.file" placeholder="ve" accept="application/pdf" required>

            <label for="Name">اسم الملف:</label>
            <input type="text" id="Name" class="rounded-2 form-control" name="Name" asp-for="@Model.Name" placeholder="File Name" required>

            <input value="@ViewBag.Courseid" asp-for="@Model.CourseId" hidden />

            <button type="submit" id="saveButton" class="btn fw-bold">Save</button> <br />

        </form>
    }
    else
    {
        <p class="container py-3">هذه الصفحة مخصصة للمشرفين والمدرسين فقط.</p>
    }



    <script src="~/js/pdf.js"></script>
    <script src="~/js/bootstrap.bundle.min.js.map"></script>
</body>
