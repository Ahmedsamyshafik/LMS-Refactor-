@model LMS.ViewModels.QuizVM.CorrectWrittenVM

@{
	ViewData["Title"] = "Correcting";
}

<h1>Correcting</h1>

@if (TempData["QuizMessage"] is string message)
{
	<div role="status" class="alert alert-info">@message</div>
}

<form method="post" asp-action="CorrectWritten" asp-route-id="@Model.CourseId">
	<table class="table table-bordered table-striped" style="width:90%">
		<thead>
			<tr>
				<th>
					Student Name
				</th>
				<th>
					Exam Name
				</th>
				<th>
					Solution
				</th>
				<th>
					Exam Degree
				</th>
				<th>
					Max Degree
				</th>
			</tr>

		</thead>
		<tbody>
			@if (Model.Attempts.Count > 0)
			{
				@for (var i = 0; i < Model.Attempts.Count; i++)
				{
					<tr>
						<td width="20%">
							<input type="hidden" name="correctquiz[@i].Id" value="@Model.Attempts[i].Id" />
							@Model.Attempts[i].StudentName
						</td>
						<td width="20%">
							@Model.Attempts[i].QuizName
						</td>
						<td width="20%">
							<a asp-action="DisplayPdf" asp-route-id="@Model.Attempts[i].Id">FILE</a>
						</td>
						<td width="20%">
							<label class="visually-hidden" for="examDegree-@Model.Attempts[i].Id">درجة الطالب @Model.Attempts[i].StudentName</label>
							<input type="number" id="examDegree-@Model.Attempts[i].Id" name="correctquiz[@i].ExamDegree" value="@Model.Attempts[i].ExamDegree" class="form-control" min="0" />
						</td>
						<td width="20%">
							<label class="visually-hidden" for="maxDegree-@Model.Attempts[i].Id">الدرجة العظمى لمحاولة @Model.Attempts[i].QuizName</label>
							<input type="number" id="maxDegree-@Model.Attempts[i].Id" name="correctquiz[@i].MaxDegree" value="@Model.Attempts[i].MaxDegree" class="form-control" min="0" />
						</td>
					</tr>
				}

			}
			else
			{
				<tr>
					<td colspan="5">لا توجد محاولات مقالية مُسلَّمة لهذه المادة.</td>
				</tr>
			}
		</tbody>
	</table>
	<button type="submit" class="btn btn-success">Save</button>
</form>
