@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5 text-center">
    <h1 class="text-danger">@Model.StatusCode &mdash; @Model.Title</h1>

    @if (Model.IsNotFound)
    {
        <p class="text-muted">العنصر المطلوب غير موجود أو تم حذفه.</p>
    }
    else
    {
        <p class="text-muted">تعذّر إكمال طلبك، حاول مرة أخرى لاحقاً.</p>
    }

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">العودة إلى الصفحة الرئيسية</a>
</div>
