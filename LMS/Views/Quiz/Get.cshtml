@model LMS.ViewModels.QuizVM.TakeExamVM
@{
	ViewData["Title"] = "TakeQuiz";
}

<head>
	<meta charset="UTF-8">
	<!-- <link rel="stylesheet" href="css/edit.css"> -->
	<link rel="stylesheet" href="~/css/pull.css">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
	<link rel="stylesheet" href="~/css/all.min.css">
	<link rel="stylesheet" href="~/css/bootstrap.min.css">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@200;300;400;500;600&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="~/css/bootstrap.min.css">
	<link rel="stylesheet" href="~/css/bootstrap.min.css.map">
	<title>@Model.Quiz.Name</title>
</head>
<div class="loader">
	<div class="parent-load">
		<svg xml:space="preserve" viewBox="0 0 80 80" height="80px" width="80px" y="0px" x="0px" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg" id="Layer_1" version="1.1" class="clock">  <image href="data:image/png;base64," y="0" x="0" height="80" width="80" id="image0"></image>
			</svg>
		<div class="stage"></div>
		<div class="hold">
			<div class="ball"></div>
		</div>
	</div>

	<div class="parent-time">
		<h1> @Model.Quiz.Name</h1>
		<p> <span id="countdown" role="timer" aria-live="polite" aria-label="الوقت المتبقي للامتحان">@Model.CountdownText</span></p>

	</div>
</div>

@if (Model.IsWrittenExam)
{
	<form id="examForm" class="container py-3" method="post" asp-action="SubmitWritten" asp-controller="Quiz" asp-route-id="@Model.Quiz.Id" enctype="multipart/form-data">

		<div class="pdf-container container" style="width: 100%; height: 100vh;">
			<embed src="~/@Model.Quiz.FilePath" type="application/pdf" width="100%" height="100%">
		</div>

		<label for="File">File:</label>
		<input type="file" id="File" name="File" class="form-control rounded-2" accept="application/pdf" required />
		<button type="submit" class="btn btn-info">Submit</button>

	</form>
	<br />


}
else
{
	var questions = Model.Quiz.Questions.ToList();
	<form id="examForm" method="post" asp-action="Submit" asp-controller="Quiz">

		@for (int i = 0; i < questions.Count; i++)
		{
			<fieldset class="pre">
				<legend>@questions[i].Text</legend>
				<div class="pre">
					@for (int j = 0; j < questions[i].Options.Count; j++)
					{
						<label>
							<input type="radio" name="selectedAnswers[@i]" value="@j" /> @questions[i].Options.ToList()[j].Text
						</label>
						<br />
					}
				</div>
			</fieldset>
		}

		<div class="submit text-center">
			<input type="submit" value="Submit">
		</div>
		<input type="hidden" name="quizId" value="@Model.Quiz.Id" />
	</form>
}




<script>
	// The server owns the clock: it sends the seconds left when the page was rendered and checks them
	// again when the answers arrive, so a wrong device time zone can no longer end the exam early.
	(function () {
		var remainingSeconds = @Model.RemainingSeconds;
		var deadline = Date.now() + (remainingSeconds * 1000);
		var countdown = document.getElementById('countdown');
		var form = document.getElementById('examForm');
		var submitting = false;

		function pad(value) { return value < 10 ? '0' + value : '' + value; }

		function render() {
			var left = Math.ceil((deadline - Date.now()) / 1000);
			if (left < 0) { left = 0; }
			countdown.textContent = pad(Math.floor(left / 3600)) + ':' + pad(Math.floor((left % 3600) / 60)) + ':' + pad(left % 60);
			return left;
		}

		function tick() {
			if (submitting) { return; }
			if (render() === 0) {
				submitting = true;
				// A written exam with no uploaded file must still reach the server so it can close the attempt.
				var file = document.getElementById('File');
				if (file) { file.required = false; }
				form.submit();
				return;
			}
		}

		render();
		setInterval(tick, 1000);
	})();
</script>